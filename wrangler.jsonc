{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hebrew-finance-news-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "NEWS_KV",
      "id": "1c14e28c5aad45ad8c8d388e441cee52"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "DRY_RUN": "false",
    "IMPORTANCE_THRESHOLD": "4",
    "DISCLAIMER": "למידע בלבד. אין כאן המלצה לפעולה בשוק.",
    "GEMINI_MODEL": "gemini-3.8-flash",
    "GEMINI_FALLBACK_MODEL": "gemini-3.5-flash-lite",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "MAX_ITEMS_PER_RUN": "5",
    "MAX_PER_CATEGORY": "2",
    "MAX_ITEMS_PER_FEED": "4",
    "MAX_AGE_HOURS": "18",
    "DEDUPE_TTL_HOURS": "72",
    "FEEDS_PER_RUN": "12",
    "FEEDS": "",
    "EXTRA_FEEDS": "",
    "CATEGORIES": "",
    "EXTRA_CATEGORIES": "",
    "TELEGRAM_CHAT_ID": ""
  },
  "secrets": {
    "required": ["GEMINI_API_KEY", "TELEGRAM_BOT_TOKEN", "TELEGRAM_WEBHOOK_SECRET"]
  }
}
