# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
# wrangler.jsonc sets DRY_RUN to false for production deploys. Keep local runs quiet:
DRY_RUN=true
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional. Also copy each news item to this chat. Leave empty to skip.
TELEGRAM_CHAT_ID=
